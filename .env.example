# --- server ---------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# Public URL used in docs, llms.txt, /.well-known/watchtower.json and the User-Agent.
PUBLIC_BASE_URL=http://localhost:3000
LOG_LEVEL=info
# Set to true when running behind a reverse proxy so rate limits see real client IPs.
TRUST_PROXY=false

# --- database -------------------------------------------------------------
DATABASE_URL=postgres://postgres:postgres@localhost:5432/watchtower
# Apply migrations/*.sql at startup (safe with multiple replicas: uses an advisory lock).
MIGRATE_ON_START=true

# --- scheduler ------------------------------------------------------------
# Run the background checker in this process. Set false for API-only replicas.
RUN_SCHEDULER=true
SCHEDULER_TICK_MS=5000
SCHEDULER_CONCURRENCY=4
# No resource is fetched more often than this, whatever clients ask for.
MIN_CHECK_INTERVAL_SECONDS=300
DEFAULT_CHECK_INTERVAL_SECONDS=3600

# --- limits (rate limits are stored in Postgres, so they hold across replicas) ---
MAX_WATCHES_PER_CLIENT=50
MAX_WATCHES_PER_CLIENT_PER_HOST=5
# Distinct monitored URLs per website (job-board platform APIs are exempt).
MAX_RESOURCES_PER_HOST=100
MAX_ACTIVE_RESOURCES=50000
RATE_LIMIT_PER_MINUTE=120
CLIENT_CREATION_PER_HOUR=10

# --- lifecycle ------------------------------------------------------------
# Watches nobody reads (get_changes/get_watch/list_watches or a delivered webhook) expire.
WATCH_TTL_DAYS=30
CHANGE_RETENTION_DAYS=30
SNAPSHOT_RETENTION_DAYS=7

# --- outbound fetching ----------------------------------------------------
FETCH_TIMEOUT_MS=15000
MAX_BODY_BYTES=3145728
MAX_REDIRECTS=5
ALLOWED_PORTS=80,443
# Cluster-wide: one in-flight request per website, with this gap between requests.
HOST_MIN_SPACING_MS=2000
WEBHOOK_TIMEOUT_MS=10000
# USER_AGENT="WatchtowerBot/0.1 (+https://your-host; job-board monitoring for AI agents)"

# DANGER: disables SSRF protection so localhost/private IPs can be fetched.
# Only for tests and the local demo. Never enable in production.
ALLOW_PRIVATE_NETWORKS=false

# --- optional -------------------------------------------------------------
# If set, GET /metrics requires "Authorization: Bearer <METRICS_TOKEN>".
# METRICS_TOKEN=
